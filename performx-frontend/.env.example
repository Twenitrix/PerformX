# Local development uses Vite's dev proxy (/api/v1 -> http://localhost:8080/api/v1) by default.
# For AWS S3 + CloudFront deployment, set VITE_API_BASE_URL in .env.production (or stick to /api/v1 if routing /api/* through CloudFront to EC2):
# VITE_API_BASE_URL=https://your-cloudfront-domain.cloudfront.net/api/v1
# or direct to EC2:
# VITE_API_BASE_URL=http://<EC2_PUBLIC_IP>:8080/api/v1
VITE_API_BASE_URL=/api/v1
